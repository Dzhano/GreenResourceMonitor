<Page x:Class="GreenResourceMonitor.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="About">

    <Grid Background="{StaticResource BackgroundDark}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>    
            <RowDefinition Height="Auto"/> 
            <RowDefinition Height="*"/>    
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>    
            <ColumnDefinition Width="500"/>  
            <ColumnDefinition Width="*"/>    
        </Grid.ColumnDefinitions>

        <Border Grid.Row="1" Grid.Column="1" 
                Style="{StaticResource KpiCard}" 
                Padding="30" 
                Margin="0"> 
            
            <StackPanel>
                <TextBlock Text="Green Resource Monitor" 
                           Foreground="{StaticResource PrimaryGreen}" 
                           FontSize="24" FontWeight="Bold" 
                           HorizontalAlignment="Center" Margin="0,0,0,5"/>
                
                <TextBlock Text="Version 1.0 (Beta)" 
                           Foreground="{StaticResource TextMuted}" 
                           FontSize="12" 
                           HorizontalAlignment="Center" Margin="0,0,0,25"/>

                <TextBlock Text="The Mission" Foreground="{StaticResource TextLight}" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock TextWrapping="Wrap" Foreground="#CCC" LineHeight="20" Margin="0,0,0,15">
                    Modern software consumes significant electricity, yet this impact is often invisible. 
                    Green Resource Monitor bridges the gap between computer science and environmental responsibility.
                </TextBlock>

                <TextBlock Text="How It Works" Foreground="{StaticResource TextLight}" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock TextWrapping="Wrap" Foreground="#CCC" LineHeight="20" Margin="0,0,0,25">
                    This application monitors active processes in real-time, estimating their energy consumption (Wh) and Carbon footprint (CO₂).
                </TextBlock>

                <Separator Background="#444" Margin="0,0,0,15"/>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <TextBlock Text="Developed by: " Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Text="Dzhano Mihaylov" Foreground="{StaticResource TextLight}" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="LinkedInButton" Content="Connect on LinkedIn" 
                            Click="LinkedInButton_Click"
                            Style="{StaticResource ModernBtn}"
                            Background="#0077B5" 
                            Width="160" Margin="0,0,15,0"/>

                    <Button Content="⬅ Go Back" 
                            Click="GoBackButton_Click"
                            Style="{StaticResource SecondaryBtn}" 
                            Width="100"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>