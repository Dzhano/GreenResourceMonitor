<Window x:Class="GreenResourceMonitor.ViewModels.GraphsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GreenResourceMonitor.ViewModels" 
        xmlns:scott="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        mc:Ignorable="d"
        Title="Data Visualization" Height="600" Width="1000"
        Background="{StaticResource BackgroundDark}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Historical Data Analysis" Foreground="{StaticResource TextLight}" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

        <Border Grid.Row="1" Background="{StaticResource SurfaceDark}" CornerRadius="5" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <StackPanel Margin="0,0,15,0">
                        <TextBlock Text="Process:" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,0,0,5"/>
                        <ComboBox x:Name="ProcessCombo" 
                                  Width="200" Height="30"
                                  SelectionChanged="ProcessCombo_SelectionChanged"
                                  SelectedIndex="0"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,15,0">
                        <TextBlock Text="Metric:" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,0,0,5"/>
                        <ComboBox x:Name="MetricCombo" 
                                  Width="150" Height="30" 
                                  SelectionChanged="MetricCombo_SelectionChanged"
                                  SelectedIndex="2"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,15,0">
                        <TextBlock Text="Start Date:" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,0,0,5"/>
                        <DatePicker x:Name="StartDatePicker" Width="120" Height="30"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="End Date:" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,0,0,5"/>
                        <DatePicker x:Name="EndDatePicker" Width="120" Height="30"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Bottom">
                    <Button Content="🔄 Refresh" Width="90" Height="30" 
                            Click="Refresh_Click" Style="{StaticResource SecondaryBtn}" Margin="0,0,10,0"/>

                    <Button Content="💾 Export" Width="90" Height="30" 
                            Click="ExportButton_Click" Style="{StaticResource ModernBtn}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="5" Padding="5">
            <scott:WpfPlot x:Name="PlotView"/>
        </Border>
    </Grid>
</Window>