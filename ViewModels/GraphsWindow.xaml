<Window x:Class="GreenResourceMonitor.ViewModels.GraphsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GreenResourceMonitor.ViewModels" 
        xmlns:scott="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        mc:Ignorable="d"
        Title="GraphsWindow" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="60*"/>
            <RowDefinition Height="131*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Process:" VerticalAlignment="Center"/>
            <ComboBox x:Name="ProcessCombo" Width="250" Margin="10 0"
                      SelectionChanged="ProcessCombo_SelectionChanged"/>
            <Button Content="Refresh" Width="80" Click="Refresh_Click"/>
        </StackPanel>
        
        
        <scott:WpfPlot x:Name="PlotView" Grid.Row="1" Grid.RowSpan="2"/>
    </Grid>
</Window>
