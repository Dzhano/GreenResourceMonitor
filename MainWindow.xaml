<Window x:Class="GreenResourceMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GreenResourceMonitor"
        mc:Ignorable="d"
        Title="Green Resource Monitor" Height="600" Width="1200"
        Background="{StaticResource BackgroundDark}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Green Resource Monitor" 
                       Foreground="{StaticResource TextLight}" 
                       FontSize="24" FontWeight="Bold" 
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"/>

            <StackPanel Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="TimeLabel" 
                           Text="00:00:00" 
                           Foreground="{StaticResource PrimaryGreen}" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Right"/>

                <TextBlock x:Name="DateLabel" 
                           Text="Monday, 01 January 2025" 
                           Foreground="{StaticResource TextMuted}" 
                           FontSize="12" 
                           HorizontalAlignment="Right"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource KpiCard}">
                <StackPanel>
                    <TextBlock Text="TOTAL ENERGY" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                    <Label x:Name="TotalEnergyLabel" Content="0.0000 Wh" 
                           Foreground="{StaticResource PrimaryGreen}" 
                           FontSize="20" FontWeight="Bold" Padding="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource KpiCard}">
                <StackPanel>
                    <TextBlock Text="TOTAL EMISSIONS" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                    <Label x:Name="TotalCO2Label" Content="0.000 g" 
                           Foreground="#FFC107" 
                           FontSize="20" FontWeight="Bold" Padding="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource KpiCard}" Margin="0">
                <StackPanel>
                    <TextBlock Text="SESSION STATUS" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                    <TextBlock Text="{Binding Status}" 
                               Foreground="{StaticResource TextLight}" 
                               FontSize="20" FontWeight="Bold" Padding="0,5,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Column="0">
                <Button x:Name="StartButton" Content="▶ Start Monitoring" 
                        Click="StartButton_Click" 
                        Style="{StaticResource ModernBtn}" Width="140" Margin="0,0,10,0"/>

                <Button x:Name="StopButton" Content="■ Stop" 
                        Click="StopButton_Click" 
                        Style="{StaticResource SecondaryBtn}" Width="100"
                        Background="{StaticResource DangerRed}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Grid.Column="2">
                <Button Content="📊 Graphs" Click="GraphsButton_Click" 
                        Style="{StaticResource SecondaryBtn}"
                        Margin="0,0,10,0"/>
                <Button Content="⚙ Settings" 
                        Click="SettingsButton_Click" 
                        Style="{StaticResource SecondaryBtn}"
                        Margin="0,0,10,0"/>
                <Button Content="ℹ About" Click="AboutButton_Click" 
                        Style="{StaticResource SecondaryBtn}"/>
            </StackPanel>
        </Grid>

        <DataGrid x:Name="ProcessesGrid" Grid.Row="3"
                  ItemsSource="{Binding Snapshots}"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="60"/>
                <DataGridTextColumn Header="Process Name" Binding="{Binding ProcessName}" Width="2*"/>
                <DataGridTextColumn Header="CPU (%)" Binding="{Binding CpuPercent}" Width="Auto"/>
                <DataGridTextColumn Header="Memory" Binding="{Binding WorkingSetReadable}" Width="Auto"/>
                <DataGridTextColumn Header="Energy (Wh)" Binding="{Binding EnergyWh, StringFormat=F6}" Width="*"/>
                <DataGridTextColumn Header="CO₂ (g)" Binding="{Binding CO2Grams, StringFormat=F4}" Width="*"/>
                <DataGridTextColumn Header="Cost (€/Wh)" Binding="{Binding CostEUR, StringFormat=F12}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        
        <Frame x:Name="MainFrame" 
               Grid.Row="0" Grid.RowSpan="4" 
               NavigationUIVisibility="Hidden" 
               Visibility="Collapsed"/>
    </Grid>
</Window>