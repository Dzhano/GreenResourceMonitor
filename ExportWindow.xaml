<Window x:Class="GreenResourceMonitor.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GreenResourceMonitor"
        mc:Ignorable="d"
        Title="Export Data" Height="300" Width="400"
        Background="{StaticResource BackgroundDark}"
        ResizeMode="NoResize">

    <Border Padding="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Export Data" 
                       Foreground="{StaticResource TextLight}" 
                       FontSize="20" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,0,0,10"/>

            <TextBlock Text="Choose your preferred format:" 
                       Foreground="{StaticResource TextMuted}" 
                       HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <Button Content="📄 Export as CSV" 
                    Click="CSVButton_Click" 
                    Style="{StaticResource ModernBtn}" 
                    Height="40" Margin="0,0,0,10"/>

            <Button Content="📊 Export as Excel" 
                    Click="ExcelButton_Click" 
                    Style="{StaticResource SecondaryBtn}" 
                    Height="40" Margin="0,0,0,10"/>

            <Button Content="｛ ｝ Export as JSON" 
                    Click="JSONButton_Click" 
                    Style="{StaticResource SecondaryBtn}" 
                    Height="40"/>
        </StackPanel>
    </Border>
</Window>